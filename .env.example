MONGO_URL=your_mongodb_connection_string
DB_NAME=agb_agroparts
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_token
SHOPIFY_API_VERSION=2024-01
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret
AUTO_SYNC_INTERVAL_HOURS=6
CRM_API_URL=https://your-crm.example.com/api
CRM_INTEGRATION_KEY=your_integration_key
# Comma-separated list of exact origins allowed to make credentialed CORS
# requests (e.g. https://agb-agroparts.ro,https://admin.agb-agroparts.ro).
# WEBSHOP_PUBLIC_URL below is always included automatically too - this is
# only for any additional origins (e.g. a separate admin/CRM frontend).
CORS_ALLOWED_ORIGINS=
WEBSHOP_PUBLIC_URL=https://your-webshop.example.com
# TTL (in days) for new session tokens (tokens[] entries minted from the
# session-expiry deploy onward - see _new_session_token_doc in server.py).
# Sessions issued before that deploy are unaffected (never retroactively
# expired). Optional - defaults to 30 if unset.
SESSION_TOKEN_TTL_DAYS=30
# BFF (Backend-for-Frontend) admin auth - verify-only side. CRM signs
# short-lived (5-15 min) Ed25519 JWTs for staff admin sessions; this backend
# only verifies them with the matching PUBLIC key (see _verify_bff_jwt in
# server.py). Multi-line PEM, standard "-----BEGIN PUBLIC KEY-----" format.
# MANDATORY, not optional: this is now the ONLY accepted credential for
# /admin/* and every other _require_admin-gated route - the legacy native
# session-token fallback has been retired. If unset, every admin-gated
# route (including CRM's own webshop-admin proxy) fails closed with 503.
CRM_BFF_JWT_PUBLIC_KEY=
# Separate shared secret from CRM_INTEGRATION_KEY above (that one is for
# the unrelated /integrations/* channel) - authenticates CRM's call to
# POST /api/internal/revoke-bff-admin (header X-CRM-BFF-Service-Key). If
# unset, that endpoint fails closed with 503 for every request.
CRM_BFF_SERVICE_KEY=
# FAN Courier API credentials - used only by GET /auth/orders/{order_id}/
# courier-tracking (customer-facing live delivery status), via
# courier_fan.py. Same variable names as agb-crm uses (which owns AWB
# generation) - copy the same values here. If unset, that one endpoint
# returns a clear 502 error instead of crashing; nothing else in this app
# depends on these.
FAN_COURIER_USERNAME=
FAN_COURIER_PASSWORD=
FAN_COURIER_CLIENT_ID=
